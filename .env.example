# Copy to `.env` and adjust. Every variable here is optional: conf/*.yaml ships with
# working defaults for a local, dependency-free run.

# ---- Environment ----
F1CP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=console          # console | json

# ---- Database ----
# Local default (no server required):
DATABASE_URL=sqlite:///data/f1cp.db
# Docker Compose:
# DATABASE_URL=postgresql+psycopg://f1cp:f1cp@postgres:5432/f1cp
POSTGRES_USER=f1cp
POSTGRES_PASSWORD=f1cp
POSTGRES_DB=f1cp

# ---- MLflow ----
MLFLOW_ENABLED=true
# Local default (SQLite-backed store; MLflow 3.x no longer accepts a plain file store):
MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db
# Docker Compose:
# MLFLOW_TRACKING_URI=http://mlflow:5000

# ---- Services ----
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501

# ---- Data acquisition ----
# Seasons before this one are treated as immutable and cached forever.
F1CP_IMMUTABLE_BEFORE=2026

# ---- Kaggle provider (optional; not on the default ingestion path) ----
# KAGGLE_USERNAME=
# KAGGLE_KEY=
